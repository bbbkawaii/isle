# ===== 数据库 =====
# 本地 Docker Postgres（schema 已是 postgresql，不要再用 sqlite file:）
# docker run -d --name island-pg -e POSTGRES_USER=island -e POSTGRES_PASSWORD=island -e POSTGRES_DB=island -p 5433:5432 postgres:16-alpine
# DATABASE_URL="postgresql://island:island@127.0.0.1:5433/island"
# Supabase / Vercel：Transaction pooler（端口 6543）；不要提交真实密码
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# 一次性建表与灌种子时使用 Session pooler（端口 5432）
# DATABASE_MIGRATION_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

